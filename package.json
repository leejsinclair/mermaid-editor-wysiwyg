{
  "name": "mermaid-editor-wysiwyg",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build",
    "typecheck": "react-router typegen && tsc --noEmit",
    "lint": "npm run lint:js && npm run lint:css && npm run lint:html && npm run lint:md && npm run lint:mermaid",
    "lint:js": "eslint .",
    "lint:css": "stylelint \"app/**/*.css\" --allow-empty-input",
    "lint:html": "htmlhint \"app/**/*.html\" \"e2e/**/*.html\"",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lint:md": "markdownlint-cli2",
    "lint:mermaid": "node scripts/lint-mermaid.mjs"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/material": "^9.5.0",
    "@xyflow/react": "^12.12.0",
    "markdownlint-cli2": "^0.23.3",
    "mermaid": "^12.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.4.0",
    "isbot": "^5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.1",
    "@react-router/dev": "^8.4.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-security": "^4.2.0",
    "eslint-plugin-sonarjs": "^4.2.2",
    "globals": "^17.13.0",
    "htmlhint": "^1.9.2",
    "jsdom": "^29.1.1",
    "stylelint": "^17.16.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "~6.0",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
